# Copy to .env and fill in. Never commit .env.

# Database. Generate the password with: openssl rand -base64 32
POSTGRES_USER=stack
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=accounts

# Caddy
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=reports.example.com

# API. API_IP_ALLOWLIST is optional and comma-separated; empty allows all.
# Rotate JWT_SECRET with scripts/rotate_secret.sh
API_IP_ALLOWLIST=
JWT_SECRET=change-me-long-random
JWT_EXPIRE_MINUTES=120

# ILG Forms sync: off unless this is production (see CLAUDE.md)
ILGFORMS_OUTBOUND=off

# Adminer (database UI). Keep it on 127.0.0.1 and use an SSH tunnel:
#   ssh -i ~/adminer -N -L 8080:127.0.0.1:8080 root@<server>
# Never 0.0.0.0: it would be open to the internet (Docker bypasses ufw).
ADMINER_BIND=127.0.0.1
ADMINER_PORT=8080

# First super admin, also used by scripts/comments_smoke-check.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
